#!/bin/sh /etc/rc.common
# QModem owns USB binding, dialing, AT ports and durable SMS processing.
START=99
STOP=15
USE_PROCD=1
start_service() {
    [ "$(uci -q get at-webserver.config.enabled)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/at-webserver
    procd_set_param respawn 3600 10 3
    procd_set_param limits core="0 0"
    procd_set_param env GOMEMLIMIT=32MiB GOMAXPROCS=2
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() { stop; start; }
service_triggers() { procd_add_reload_trigger at-webserver; }
