diff --git a/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh b/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
index a384c11..0624057 100644
--- a/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
+++ b/target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
@@ -99,6 +99,13 @@ platform_do_upgrade() {
 	local board=$(board_name)
 
 	case "$board" in
+	NRadio-C2000MAX-Ultra|NRadio-C2000Ultra)
+		CI_ROOTDEV="mmcblk0"
+		CI_KERNPART="kernel"
+		CI_ROOTPART="rootfs_2nd"
+		EMMC_ROOTFS_DATA_OFFSET=536870912
+		emmc_do_upgrade "$1"
+		;;
 	abt,asr3000|\
 	acer,predator-w6x-ubootmod|\
 	aigo,ags21|\
@@ -328,6 +335,19 @@ platform_check_image() {
 	[ "$#" -gt 1 ] && return 1
 
 	case "$board" in
+	NRadio-C2000MAX-Ultra|NRadio-C2000Ultra)
+		nand_do_platform_check "nradio_c2000ultra" "$1" || return 1
+		# Layout 2 images use the 512 MiB reservation; reject old-layout payloads.
+		local compat root_bytes kernel_bytes
+		compat=$(fwtool -i /dev/stdout "$1" 2>/dev/null | jsonfilter -e '@.compat_version')
+		[ "$compat" = "2.0" ] || { echo "Unsupported Ultra TF layout; expected compatibility 2.0" >&2; return 1; }
+		root_bytes=$(tar tvf "$1" sysupgrade-nradio_c2000ultra/root 2>/dev/null | awk '{print $3}')
+		kernel_bytes=$(tar tvf "$1" sysupgrade-nradio_c2000ultra/kernel 2>/dev/null | awk '{print $3}')
+		case "$root_bytes:$kernel_bytes" in *[!0-9:]*|:*|*:) return 1;; esac
+		[ "$root_bytes" -gt 0 ] && [ "$root_bytes" -le 536870912 ] &&
+			[ "$kernel_bytes" -gt 0 ] && [ "$kernel_bytes" -lt 33554432 ]
+		return $?
+		;;
 	abt,asr3000|\
 	acer,predator-w6x-ubootmod|\
 	aigo,ags21|\
@@ -420,6 +440,12 @@ platform_check_image() {
 
 platform_copy_config() {
 	case "$(board_name)" in
+	NRadio-C2000MAX-Ultra|NRadio-C2000Ultra)
+		CI_ROOTDEV="mmcblk0"
+		CI_KERNPART="kernel"
+		CI_ROOTPART="rootfs_2nd"
+		emmc_copy_config
+		;;
 	acer,predator-w6|\
 	acer,predator-w6d|\
 	acer,vero-w6m|\
