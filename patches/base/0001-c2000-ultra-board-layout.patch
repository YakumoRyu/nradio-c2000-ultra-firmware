diff --git a/package/base-files/files/lib/upgrade/emmc.sh b/package/base-files/files/lib/upgrade/emmc.sh
index fc40f3c..70de979 100644
--- a/package/base-files/files/lib/upgrade/emmc.sh
+++ b/package/base-files/files/lib/upgrade/emmc.sh
@@ -33,6 +33,13 @@ emmc_upgrade_tar() {
 		export EMMC_ROOTFS_BLOCKS=$(($(tar x${gz}f "$tar_file" ${board_dir}/root -O | dd of="$EMMC_ROOT_DEV" bs=512 2>&1 | grep "records out" | cut -d' ' -f1)))
 		# Account for 64KiB ROOTDEV_OVERLAY_ALIGN in libfstools
 		EMMC_ROOTFS_BLOCKS=$(((EMMC_ROOTFS_BLOCKS + 127) & ~127))
+		# Some TF boards reserve a fixed data offset across image-size changes.
+		# The platform checks payload size before any write; use the same boundary
+		# for reset/config backup as libfstools uses when mounting rootfs_data.
+		if [ -n "$EMMC_ROOTFS_DATA_OFFSET" ]; then
+			[ "$EMMC_ROOTFS_BLOCKS" -le "$((EMMC_ROOTFS_DATA_OFFSET / 512))" ] || return 1
+			EMMC_ROOTFS_BLOCKS=$((EMMC_ROOTFS_DATA_OFFSET / 512))
+		fi
 		sync
 	}
 	[ "$has_dtb" = 1 -a "$EMMC_DTB_DEV" ] &&
