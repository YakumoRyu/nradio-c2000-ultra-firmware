+++ b/application/qmodem/files/etc/init.d/qmodem_network
@@ -21,8 +21,22 @@ service_triggers()
 
 start_service(){
     force_stop=0
-    mkdir -p $MODEM_RUNDIR
-    update_modem
+    mkdir -p "$MODEM_RUNDIR"
+    # rc.common already opened a procd service JSON transaction. Declare all
+    # desired instances here; nesting rc_procd would destroy that transaction.
+    config_load qmodem
+    config_get g_enabled main enable_dial
+    config_foreach _register_enabled_modem modem-device
+}
+
+_register_enabled_modem(){
+    local enabled state
+    config_get enabled "$1" enable_dial
+    config_get state "$1" state
+    [ "$g_enabled" = "0" ] && return 0
+    [ "$enabled" = "0" ] && return 0
+    [ "$state" = "disabled" ] && return 0
+    _dial "$1"
 }
 
