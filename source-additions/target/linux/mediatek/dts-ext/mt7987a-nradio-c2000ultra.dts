// SPDX-License-Identifier: (GPL-2.0 OR MIT)
// Candidate board port, derived from this router's running DTB.
// Not accepted for installation until kernel/DTS/driver validation completes.
/dts-v1/;
#include "mt7987a.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "NRadio-C2000Ultra";
	compatible = "NRadio-C2000MAX-Ultra", "mediatek,mt7987a", "mediatek,mt7987";

	aliases {
		serial0 = &uart0;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		// Public image reserves 512 MiB for read-only programs and fixes.
		openwrt,rootfs-data-offset = <536870912>;
		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf root=PARTLABEL=rootfs_2nd rootwait rootfstype=squashfs,f2fs cgroup_no_v1=all";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		reset { label = "reset"; linux,code = <KEY_RESTART>; gpios = <&pio 1 GPIO_ACTIVE_LOW>; debounce-interval = <10>; };
		wps { label = "wps"; linux,code = <KEY_WPS_BUTTON>; gpios = <&pio 0 GPIO_ACTIVE_LOW>; debounce-interval = <10>; };
	};

	gpio-leds {
		compatible = "gpio-leds";
		led_status: status { label = "hc:blue:status"; gpios = <&pio 9 GPIO_ACTIVE_LOW>; default-state = "on"; };
		cmode5 { label = "hc:blue:cmode5"; gpios = <&pio 8 GPIO_ACTIVE_LOW>; };
		cmode4 { label = "hc:blue:cmode4"; gpios = <&pio 11 GPIO_ACTIVE_LOW>; };
		internet { label = "hc:red:int"; gpios = <&pio 10 GPIO_ACTIVE_LOW>; };
		error { label = "hc:red:error"; gpios = <&pio 12 GPIO_ACTIVE_LOW>; };
	};

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;
		cpepower { gpio-export,name = "cpe-pwr"; gpio-export,output = <0>; gpios = <&pio 49 GPIO_ACTIVE_LOW>; };
		cpesel0 { gpio-export,name = "cpe-sel0"; gpio-export,output = <0>; gpios = <&pio 48 GPIO_ACTIVE_HIGH>; };
	};
};

&eth { status = "okay"; };

&gmac0 {
	phy-mode = "2500base-x";
	phy-handle = <&ultra_phy0>;
	status = "okay";
};

&gmac1 {
	phy-mode = "internal";
	phy-handle = <&ultra_phy1>;
	status = "okay";
};

&gmac2 {
	phy-mode = "internal";
	label = "hnat";
	status = "okay";
	fixed-link { speed = <2500>; full-duplex; pause; };
};

&mdio {
	#address-cells = <1>;
	#size-cells = <0>;
	ultra_phy0: ethernet-phy@b {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <11>;
		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <10000>;
		phy-mode = "2500base-x";
		full-duplex;
		pause;
		airoha,phy-handle;
	};
	ultra_phy1: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
		phy-mode = "internal";
		pinctrl-names = "i2p5gbe-led";
		pinctrl-0 = <&i2p5gbe_led0_pins>;
	};
};

&hnat {
	mtketh-wan = "eth1";
	mtketh-lan = "eth0";
	mtketh-lan2 = "hnat";
	mtketh-ppd = "hnat";
	mtketh-max-gmac = <2>;
	mtketh-ppe-num = <2>;
	ext-devices-prefix = "usb", "wwan", "rmnet", "eth2", "eth3";
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc_pins_default>;
	pinctrl-1 = <&mmc_pins_uhs>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_3p3v>;
	non-removable;
	no-mmc;
	no-sdio;
	broken-cd;
	status = "okay";
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	// The 6.12 PCI driver asserts logical 1 then deasserts logical 0.
	// The running board leaves GPIO38 physically high; ACTIVE_LOW preserves it.
	wifi-reset-gpios = <&pio 38 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <1000>;
	wifi-deassert-msleep = <500>;
	status = "okay";
};

&pcie1 { status = "disabled"; };

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&c2ku_spi2_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	spi_nor@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@40000 { label = "u-boot-env"; reg = <0x40000 0x10000>; };
			factory: partition@50000 { label = "Factory"; reg = <0x50000 0x100000>; read-only; };
			partition@150000 { label = "bdinfo"; reg = <0x150000 0x80000>; read-only; };
		};
	};
};

&pio {
	c2ku_spi2_pins: c2ku-spi2-pins { mux { function = "spi"; groups = "spi2"; }; };
	ultra_fan_pins: ultra-fan-pins { mux { function = "pwm"; groups = "pwm1_0"; }; };
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&ultra_fan_pins>;
	status = "okay";
};

&fan {
		pwms = <&pwm 1 50000>;
	status = "okay";
};

&ssusb { status = "okay"; };
&tphyu3port0 { status = "okay"; };
&uart0 { pinctrl-names = "default"; pinctrl-0 = <&uart0_pins>; status = "okay"; };
