+
+/* Preserve an explicitly reserved overlay location across SquashFS rebuilds.
+ * A malformed or overlapping reservation must never fall back to a new offset.
+ */
+static int rootdisk_apply_fixed_offset(const char *path, uint64_t *offset)
+{
+	unsigned char raw[4];
+	uint64_t fixed;
+	FILE *f = fopen(path, "rb");
+
+	if (!f)
+		return errno == ENOENT ? 0 : -1;
+
+	if (fread(raw, 1, sizeof(raw), f) != sizeof(raw) || fgetc(f) != EOF || ferror(f)) {
+		fclose(f);
+		return -1;
+	}
+	fclose(f);
+	fixed = ((uint64_t)raw[0] << 24) | ((uint64_t)raw[1] << 16) |
+		((uint64_t)raw[2] << 8) | raw[3];
+	if (!fixed || (fixed & (ROOTDEV_OVERLAY_ALIGN - 1)) || fixed < *offset)
+		return -1;
+	*offset = fixed;
+	return 0;
 }
 
 static int get_squashfs(struct squashfs_super_block *sb)
