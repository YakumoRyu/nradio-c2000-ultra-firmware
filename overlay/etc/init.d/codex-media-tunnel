#!/bin/sh /etc/rc.common
START=98
STOP=09
USE_PROCD=1
start_service() {
    [ -f /etc/cloudflared/config.yml ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/cloudflared --no-autoupdate tunnel --config /etc/cloudflared/config.yml run
    procd_set_param env GOMAXPROCS=2 GOMEMLIMIT=80MiB
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/cloudflared/config.yml
    procd_close_instance
}
