#!/bin/sh /etc/rc.common
START=97
STOP=08
USE_PROCD=1
start_service() {
    [ "$(uci -q get pcdn.main.enabled)" = 1 ] || return 0
    /usr/libexec/pcdn1-config.py >/tmp/pcdn1-prefix-state.json || return 1
    /usr/sbin/dnsmasq --test --conf-file=/var/etc/pcdn-port1.conf || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/etc/pcdn-port1.conf
    procd_set_param respawn
    procd_set_param file /var/etc/pcdn-port1.conf
    procd_close_instance
}
service_triggers() {
    procd_add_reload_interface_trigger pcdn1
}
