#!/bin/sh /etc/rc.common
START=99
STOP=08
USE_PROCD=1
start_service() {
    [ -f /overlay/media-stack/state/root/autofilm-v2/config/config.yaml ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/codex-media/media-health.py
    procd_set_param nice 10
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
