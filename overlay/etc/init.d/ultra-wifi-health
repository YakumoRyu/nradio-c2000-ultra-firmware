#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/libexec/ultra-wifi-health
	procd_set_param respawn 60 5 5
	procd_set_param nice 10
	procd_set_param limits nofile="128 128" core="0 0"
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
