#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get codex_docker.main.enabled)" = 1 ] || return 0
    mkdir -p /var/run/codex-docker
    # Initialize controller hierarchy before procd starts the daemon in its leaf.
    local cg
    mkdir -p /sys/fs/cgroup/services/codex-docker
    for cg in /sys/fs/cgroup /sys/fs/cgroup/services /sys/fs/cgroup/services/codex-docker; do
        printf '+cpu +memory +pids\n' > "$cg/cgroup.subtree_control" || return 1
    done
    procd_open_instance
    procd_set_param env PATH=/usr/lib/codex-docker/bin:/usr/sbin:/usr/bin:/sbin:/bin
    procd_set_param command /usr/libexec/codex-dockerd
    procd_set_param limits nofile="65536 65536"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/codex-docker/daemon.json
    procd_close_instance
}
