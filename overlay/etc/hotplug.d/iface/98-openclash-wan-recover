#!/bin/sh
# Mark WAN events only. Cron performs bounded checks outside the netifd hotplug path.
case "$INTERFACE:$DEVICE" in
    2_1:*|2_1v6:*|*:eth2) ;;
    *) exit 0 ;;
esac
case "$ACTION" in
    ifup|ifdown) ;;
    ifupdate)
        [ "$IFUPDATE_ADDRESSES" = 1 ] || [ "$IFUPDATE_PREFIXES" = 1 ] || [ "$IFUPDATE_ROUTES" = 1 ] || exit 0
        ;;
    *) exit 0 ;;
esac
umask 077
read -r event_uptime _ < /proc/uptime
printf '%s\n' "$event_uptime" > /tmp/openclash-wan-event
