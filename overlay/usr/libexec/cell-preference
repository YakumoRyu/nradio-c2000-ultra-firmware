#!/usr/bin/python3
"""Prefer consistently stronger measured NR neighbors through the shared AT owner."""
import argparse
from contextlib import ExitStack
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

STATE=Path('/tmp/cell-preference.json')
HISTORY=Path('/overlay/cell-preference')
SCAN=Path('/overlay/at-webserver/scan-session.json')
RUNTIME_LOCK=Path('/tmp/cell-preference.lock')
LOCK_QUERY='AT^NRFREQLOCK?'
UNLOCKED='AT^NRFREQLOCK=0'
RECOVERY_RETRY_SECONDS=180
EVENT_LOG_LIMIT=64*1024

def run(args,timeout=12):
    p=subprocess.run(args,capture_output=True,text=True,timeout=timeout)
    if p.returncode:raise RuntimeError('command_failed:'+args[0])
    return p.stdout

def config():
    raw=run(['uci','-q','show','cell_preference.main'],5)
    values={}
    for line in raw.splitlines():
        key,sep,value=line.partition('=')
        if sep:values[key.rsplit('.',1)[-1]]=value.strip("'")
    return values

def checked_config(values):
    limits={'gain_db':(3,20,6),'samples':(2,10,3),'cooldown_seconds':(600,86400,1800),'min_sinr_db':(-5,20,0),'max_sinr_loss_db':(0,6,3),'max_rsrq_loss_db':(0,6,3)}
    result=dict(values)
    for key,(low,high,default) in limits.items():
        value=int(values.get(key,default))
        if not low<=value<=high:raise ValueError('invalid_'+key)
        result[key]=value
    port=values.get('at_port','/dev/ttyUSB1')
    if not re.fullmatch('/dev/ttyUSB[0-9]{1,2}',port):raise ValueError('invalid_at_port')
    result['at_port']=port
    result['preferred_arfcn']=int(values.get('preferred_arfcn','0'))
    if not 0<=result['preferred_arfcn']<=4294967295:raise ValueError('invalid_preferred_arfcn')
    result['preferred_scs']=int(values.get('preferred_scs','1'))
    if result['preferred_scs'] not in range(5):raise ValueError('invalid_preferred_scs')
    result['preferred_mobility']=int(values.get('preferred_mobility','0'))
    if result['preferred_mobility'] not in (0,1):raise ValueError('invalid_preferred_mobility')
    result['preferred_pci']=int(values.get('preferred_pci','-1'))
    if not -1<=result['preferred_pci']<=1007:raise ValueError('invalid_preferred_pci')
    return result

def at(port,command):
    text=run(['/usr/libexec/qmodem-at-ubus',port,command])
    lines=[line.strip() for line in text.splitlines() if line.strip()]
    if 'OK' not in lines or any(line=='ERROR' or line.startswith('+CME ERROR') for line in lines):
        raise RuntimeError('at_request_failed')
    return text

def lock_command(raw):
    lines=[line.strip() for line in raw.splitlines() if line.strip() and line.strip()!='OK']
    header=next((i for i,x in enumerate(lines) if x.startswith('^NRFREQLOCK:')),None)
    if header is None:raise ValueError('invalid_lock_reply')
    mode=int(lines[header].split(':',1)[1])
    if mode==0:return 'AT^NRFREQLOCK=0'
    if mode not in (1,2,3):raise ValueError('invalid_lock_type')
    mobility,count=map(int,lines[header+1].split(','))
    if mobility not in (0,1) or not 1<=count<=20:raise ValueError('invalid_lock_count')
    columns=[]
    for row in lines[header+2:header+2+count]:
        fields=row.split(',')
        if len(fields)!={1:3,2:4,3:1}[mode] or any(not re.fullmatch(r'[0-9]+',field) for field in fields):raise ValueError('invalid_lock_fields')
        columns.append(fields)
    if len(columns)!=count:raise ValueError('incomplete_lock_reply')
    return f'AT^NRFREQLOCK={mode},{mobility},{count}'+''.join(',"'+','.join(row[i] for row in columns)+'"' for i in range(len(columns[0])))

def valid_signal(row):
    return -140<=row['rsrp']<=-30 and -30<=row['rsrq']<=0 and -24<=row['sinr']<=50

def serving(raw):
    match=re.search(r'\^MONSC:\s*NR,([^\r\n]+)',raw)
    if not match:raise ValueError('no_serving_nr_cell')
    fields=match[1].split(',')
    if len(fields)<10:raise ValueError('incomplete_serving_cell')
    row={'mcc':fields[0],'mnc':fields[1],'arfcn':int(fields[2]),'scs':int(fields[3]),'nci':fields[4],'pci':int(fields[5],16),'rsrp':int(fields[7]),'rsrq':int(fields[8]),'sinr':int(fields[9])}
    if row['scs'] not in range(5) or not 0<=row['pci']<=1007 or not valid_signal(row):raise ValueError('invalid_serving_cell')
    return row

def neighbors(raw,current,cfg=None):
    rows=[]
    for line in raw.splitlines():
        match=re.fullmatch(r'\s*\^MONNC:\s*NR,(\d+),([0-9A-Fa-f]+),(-?\d+),(-?\d+),(-?\d+)\s*',line)
        if not match:continue
        freq,pci,power,quality,sinr=match.groups()
        row={'arfcn':int(freq),'scs':current['scs'],'pci':int(pci,16),'rsrp':int(power),'rsrq':int(quality),'sinr':int(sinr)}
        # Only the configured preference has a known SCS on another frequency.
        if row['arfcn']!=current['arfcn']:
            if not cfg or not cfg['preferred_mobility'] or row['arfcn']!=cfg['preferred_arfcn']:continue
            row['scs']=cfg['preferred_scs']
        if not 0<=row['pci']<=1007 or not valid_signal(row) or key(row)==key(current):continue
        rows.append(row)
    return rows

def band_for_frequency(freq):
    if 620000<=freq<=653333:return 78
    if 499200<=freq<=537999:return 41
    if 151600<=freq<=160600:return 28
    if 422000<=freq<=434000:return 1
    if 693334<=freq<=733333:return 79
    if 361000<=freq<=376000:return 3
    if 173800<=freq<=178800:return 5
    if 185000<=freq<=192000:return 8
    raise ValueError('unsupported_frequency')

def key(row):return f"{row['arfcn']}:{row['scs']}:{row['pci']}"

def home_cell(row,cfg):
    return (cfg['preferred_mobility']==1 and cfg['preferred_pci']>=0 and
            (row.get('arfcn'),row.get('scs'),row.get('pci'))==(cfg['preferred_arfcn'],cfg['preferred_scs'],cfg['preferred_pci']))

def acceptable(row,current,cfg):
    if home_cell(row,cfg):
        return (row['rsrp']>=current['rsrp']-3 and row['sinr']>=max(cfg['min_sinr_db'],current['sinr']-cfg['max_sinr_loss_db'])
                and row['rsrq']>=current['rsrq']-cfg['max_rsrq_loss_db'])
    return improves(row,current,cfg)

def decide(current,candidates,state,cfg,now):
    result=dict(state)
    if now<state.get('observed',now) or now-state.get('observed',now)>150:
        result.pop('candidate',None);result['count']=0
    result['observed']=now;result['current']=dict(current)
    preferred=cfg.get('preferred_arfcn',0)
    mobile=cfg['preferred_mobility']
    eligible=[]
    for row in candidates:
        if home_cell(current,cfg) and current['sinr']>=cfg['min_sinr_db'] and not home_cell(row,cfg):
            continue
        same_channel=(row['arfcn'],row['scs'])==(current['arfcn'],current['scs'])
        on_preference=(row['arfcn'],row['scs'])==(preferred,cfg['preferred_scs'])
        if same_channel and (mobile or not preferred or on_preference) or mobile and on_preference:
            if acceptable(row,current,cfg):eligible.append(row)
    if not eligible:
        phase='preferred_frequency_active' if preferred and current['arfcn']==preferred else 'current_best_observed'
        if preferred and current['arfcn']!=preferred:phase='preferred_frequency_unavailable'
        result.update(phase=phase,candidate=None,count=0,preferred_arfcn=preferred)
        result.pop('better_neighbor',None)
        return result,None
    best=max(eligible,key=lambda row:(home_cell(row,cfg),row['arfcn']==preferred,row['rsrp'],row['sinr'],row['rsrq']))
    if state.get('current') and key(state['current'])!=key(current):result.update(candidate=None,count=0)
    if result.get('candidate')==key(best):
        if now-result.get('candidate_sample_at',0)>=45:
            result['count']=result.get('count',0)+1;result['candidate_sample_at']=now
    else:result.update(candidate=key(best),count=1,candidate_sample_at=now)
    result['better_neighbor']=best
    attempt=state.get('last_attempt',0)
    if now<attempt or now-attempt<cfg['cooldown_seconds']:
        result['phase']='cooldown';return result,None
    if result['count']<cfg['samples']:
        result['phase']='confirming_better_neighbor';return result,None
    result.update(phase='ready',count=0)
    return result,best

def improves(row,current,cfg):
    return (row['rsrp']-current['rsrp']>=cfg['gain_db'] and row['sinr']>=cfg['min_sinr_db']
            and row['sinr']>=current['sinr']-cfg['max_sinr_loss_db']
            and row['rsrq']>=current['rsrq']-cfg['max_rsrq_loss_db'])

def atomic(path,value):
    path.parent.mkdir(parents=True,exist_ok=True)
    stage=path.with_suffix('.new');stage.write_text(json.dumps(value,ensure_ascii=False),encoding='utf-8');stage.chmod(0o600);os.replace(stage,path)

def load(path):
    try:
        value=json.loads(path.read_text(encoding='utf-8'))
        return value if isinstance(value,dict) else {}
    except (OSError,ValueError):
        return {}

def ipv6_default_present():
    return bool(run(['ip','-6','route','show','default','dev','eth2'],5).strip())

def internet_ok(require_ipv6):
    families=[([],['223.5.5.5','119.29.29.29'])]
    if require_ipv6:
        if not ipv6_default_present():return False
        families.append((['-6'],['2400:3200::1','2402:4e00::']))
    for flags,targets in families:
        reachable=False
        for target in targets:
            p=subprocess.run(['ping',*flags,'-I','eth2','-c','1','-W','2',target],capture_output=True,timeout=4)
            if p.returncode==0:reachable=True;break
        if not reachable:return False
    return True

def read_lock(port):
    return lock_command(at(port,LOCK_QUERY))

def read_serving(port):
    raw=at(port,'AT^MONSC')
    try:
        return serving(raw)
    except ValueError as error:
        if str(error)!='no_serving_nr_cell':raise
        return None

def preferred_lock(cfg):
    frequency=cfg['preferred_arfcn']
    if not frequency:return UNLOCKED
    band=band_for_frequency(frequency)
    return f'AT^NRFREQLOCK=1,{cfg["preferred_mobility"]},1,"{band}","{frequency}","{cfg["preferred_scs"]}"'

def restore_transaction(port,transaction):
    baseline=transaction['baseline']
    requested=transaction['requested']
    # Restoring a transaction must never overwrite a later manual change.
    active=read_lock(port)
    if active!=requested or active==baseline:
        return active
    if not re.fullmatch(r'AT\^NRFREQLOCK=(?:0|[123],[01],\d+(?:,"[0-9,]+"){1,4})',baseline):
        raise ValueError('invalid_restore_lock')
    at(port,baseline)
    if read_lock(port)!=baseline:raise RuntimeError('restore_not_confirmed')
    return baseline

def record_attempt(state,now):
    state['last_attempt']=now
    atomic(HISTORY/'last-attempt.json',{'epoch':now})

def report(previous,state):
    state['observed']=time.time()
    atomic(STATE,state)
    def snapshot(value):
        cell=value.get('current') or {}
        return (value.get('phase'),value.get('lock_owner'),value.get('expected_lock'),
                tuple((k,cell.get(k)) for k in ('arfcn','scs','pci')))
    if snapshot(previous)==snapshot(state):return
    # Retain transitions and radio measurements across boots, without saving AT responses or identifiers.
    try:
        path=HISTORY/'events.jsonl'
        HISTORY.mkdir(mode=0o700,parents=True,exist_ok=True)
        if path.exists() and path.stat().st_size>=EVENT_LOG_LIMIT:
            os.replace(path,HISTORY/'events.previous.jsonl')
        cell=state.get('current') or {}
        event={'epoch':state['observed'],'phase':state['phase'],'lock_owner':state.get('lock_owner'),
               'cell':{k:cell[k] for k in ('arfcn','scs','pci','rsrp','rsrq','sinr') if k in cell}}
        fd=os.open(path,os.O_APPEND|os.O_CREAT|os.O_WRONLY,0o600)
        with os.fdopen(fd,'a',encoding='utf-8') as stream:
            stream.write(json.dumps(event,separators=(',',':'))+'\n')
    except OSError:
        pass

def select_cell(current,target,cfg,baseline,probe=None):
    if probe is None:
        require_ipv6=ipv6_default_present()
        probe=lambda:internet_ok(require_ipv6)
    if not probe():return 'network_not_ready',baseline
    port=cfg['at_port']
    active=read_lock(port)
    if active!=baseline:return 'external_lock_preserved',active
    band=band_for_frequency(target['arfcn'])
    mobility=cfg['preferred_mobility'] if cfg.get('preferred_arfcn',0) else 1
    command=f'AT^NRFREQLOCK=2,{mobility},1,"{band}","{target["arfcn"]}","{target["scs"]}","{target["pci"]}"'
    journal={'epoch':time.time(),'baseline':baseline,'fallback':preferred_lock(cfg),'requested':command,'target':target}
    pending=HISTORY/'pending.json'
    atomic(pending,journal)
    try:
        at(port,command)
        if read_lock(port)!=command:raise RuntimeError('lock_not_accepted')
        # Passive mode never resets the radio or interrupts data to force selection.
        for _ in range(3):
            time.sleep(3)
            observed=read_serving(port)
            if observed and key(observed)==key(target) and acceptable(observed,current,cfg) and probe():
                if read_lock(port)!=command:raise RuntimeError('trial_lock_changed')
                journal.update(confirmed={k:observed[k] for k in ('arfcn','scs','pci','rsrp','rsrq','sinr')},finished=time.time())
                atomic(HISTORY/'last-selection.json',journal)
                pending.unlink()
                return 'selected',command
        raise RuntimeError('modem_did_not_select_requested_neighbor')
    except Exception:
        journal['last_recovery']=time.time()
        atomic(pending,journal)
        active=restore_transaction(port,journal)
        pending.unlink()
        return ('original_setting_restored' if active==baseline else 'external_lock_preserved'),active

def read_only_status(cfg):
    if cfg.get('enabled')!='1':return {'phase':'disabled'}
    with ExitStack() as locks:
        for path in (RUNTIME_LOCK,Path(str(SCAN)+'.lock')):
            try:
                guard=locks.enter_context(path.open('r'))
            except FileNotFoundError:
                continue  # Status does not create lock files.
            try:
                fcntl.flock(guard,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError:
                return {'phase':'busy'}
        if SCAN.exists():return {'phase':'scan_active'}
        port=cfg['at_port']
        return {'phase':'transaction_pending' if (HISTORY/'pending.json').exists() else 'observing',
                'expected_lock':read_lock(port),'current':read_serving(port),'observed':time.time()}

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    mode=parser.add_mutually_exclusive_group()
    mode.add_argument('--check',action='store_true')
    mode.add_argument('--enable-auto',action='store_true')
    args=parser.parse_args()
    cfg=checked_config(config())
    if args.check:
        print(json.dumps(read_only_status(cfg),ensure_ascii=False))
        return
    if cfg.get('enabled')!='1' and not args.enable_auto:return
    with open(RUNTIME_LOCK,'a') as guard:
        try:fcntl.flock(guard,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:return
        SCAN.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
        with open(str(SCAN)+'.lock','a') as scanlock:
            try:fcntl.flock(scanlock,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError:return
            if SCAN.exists():return
            old_state=load(STATE)
            state=dict(old_state)
            state.pop('error',None)
            state['last_attempt']=max(state.get('last_attempt',0),load(HISTORY/'last-attempt.json').get('epoch',0))
            port=cfg['at_port']
            baseline=read_lock(port)
            pending_path=HISTORY/'pending.json'
            pending=load(pending_path)
            if pending:
                now=time.time()
                if baseline==pending.get('requested') and baseline!=pending.get('baseline'):
                    if now-pending.get('last_recovery',0)<RECOVERY_RETRY_SECONDS:
                        report(old_state,state|{'phase':'recovery_pending','expected_lock':baseline,'current':read_serving(port)})
                        return
                    pending['last_recovery']=now
                    atomic(pending_path,pending)
                active=restore_transaction(port,pending)
                pending_path.unlink()
                record_attempt(state,now)
                phase='interrupted_selection_recovered' if active==pending['baseline'] else 'external_lock_preserved'
                report(old_state,state|{'phase':phase,'expected_lock':active,'current':None,'candidate':None,'count':0})
                return
            desired=preferred_lock(cfg)
            fallback_path=HISTORY/'mobile-fallback.json'
            fallback=load(fallback_path)
            roaming=(cfg['preferred_mobility']==1 and baseline==UNLOCKED and fallback.get('preference')==desired)
            if fallback and not roaming:
                fallback_path.unlink(missing_ok=True)
            if args.enable_auto:
                # Explicit entry into automatic mode retires an old frequency/cell lock.
                # Ordinary scheduled checks never clear a manual lock on their own.
                transition={'epoch':time.time(),'baseline':baseline,'requested':desired,'automatic_mode':True}
                atomic(pending_path,transition)
                atomic(HISTORY/('before-auto-'+str(time.time_ns())+'.json'),transition)
                try:
                    if baseline!=desired:at(port,desired)
                    if read_lock(port)!=desired:raise RuntimeError('auto_mode_not_confirmed')
                    run(['uci','set','cell_preference.main.enabled=1'],5);run(['uci','commit','cell_preference'],5)
                except Exception:
                    restore_transaction(port,transition)
                    pending_path.unlink()
                    raise
                pending_path.unlink()
                baseline=desired
                roaming=False
                fallback_path.unlink(missing_ok=True)
                state={'expected_lock':baseline,'last_attempt':state.get('last_attempt',0)}
            lock_changed=state.get('expected_lock')!=baseline
            if lock_changed:
                state.update(candidate=None,count=0,no_nr_samples=0,no_nr_sample_at=0)
            state['expected_lock']=baseline
            selection=load(HISTORY/'last-selection.json')
            selected_lock=selection.get('requested','')
            if isinstance(selected_lock,str) and selected_lock.startswith('AT^NRFREQLOCK=2,') and selection.get('confirmed') and not selection.get('retired'):
                owned=selected_lock==baseline and selection.get('fallback',selection.get('baseline'))==desired
                if not owned:
                    atomic(HISTORY/'last-selection.json',selection|{'retired':True})
            else:
                owned=False
            managed=baseline==desired or owned or roaming
            state['lock_owner']='selection' if owned else 'fallback' if roaming else 'preference' if managed else 'external'
            current=read_serving(port)
            if current is None:
                now=time.time();sample_at=state.get('no_nr_sample_at',0)
                failures=state.get('no_nr_samples',0)
                if now<sample_at or now-sample_at>150:failures=0
                if now-sample_at>=45 or failures==0:failures+=1;sample_at=now
                state.update(no_nr_samples=failures,no_nr_sample_at=sample_at,candidate=None,count=0,
                             phase='waiting_for_nr_service',current=None)
                mobile_loss=cfg['preferred_mobility']==1 and managed and baseline!=UNLOCKED
                if failures>=3 and (owned or mobile_loss):
                    destination=UNLOCKED if mobile_loss else desired
                    recovery={'epoch':now,'baseline':destination,'requested':baseline,'last_recovery':now}
                    atomic(pending_path,recovery)
                    if mobile_loss:atomic(fallback_path,{'preference':desired,'epoch':now})
                    record_attempt(state,now)
                    active=restore_transaction(port,recovery)
                    pending_path.unlink()
                    if owned:atomic(HISTORY/'last-selection.json',selection|{'retired':True})
                    if active==UNLOCKED and mobile_loss:
                        state.update(phase='fallback_after_service_loss',expected_lock=active,lock_owner='fallback')
                    else:
                        phase='previous_setting_restored_after_service_loss' if active==desired else 'external_lock_preserved'
                        state.update(phase=phase,expected_lock=active,lock_owner='preference' if active==desired else 'external')
            elif not managed:
                state.update(phase='external_lock_active',current=current,no_nr_samples=0,candidate=None,count=0)
            else:
                cells=neighbors(at(port,'AT^MONNC'),current,cfg)
                candidates=list(cells)
                # After losing the home cell, the modem can hand over on its own.
                # Relinquish our old PCI hint once that handover is confirmed.
                stale_home=(owned and home_cell(selection.get('confirmed') or {},cfg)
                            and not home_cell(current,cfg) and not any(home_cell(c,cfg) for c in cells))
                now=time.time()
                since=state.get('away_sample_at',0)
                if not stale_home or lock_changed or now<since or now-since>150:
                    state.update(away_count=0,away_sample_at=0)
                if stale_home and now-state.get('away_sample_at',0)>=45:
                    state.update(away_count=state.get('away_count',0)+1,away_sample_at=now)
                if stale_home and state['away_count']>=cfg['samples']:
                    journal={'epoch':now,'baseline':desired,'requested':baseline,'last_recovery':now}
                    atomic(pending_path,journal)
                    active=restore_transaction(port,journal)
                    pending_path.unlink()
                    atomic(HISTORY/'last-selection.json',selection|{'retired':True})
                    state.update(phase='released_absent_home' if active==desired else 'external_lock_preserved',
                                 expected_lock=active,current=current,no_nr_samples=0,count=0,candidate=None,
                                 lock_owner='preference' if active==desired else 'external',away_count=0)
                    report(old_state,state)
                    return
                if home_cell(current,cfg) and (not owned or selection.get('confirmed',{}).get('pci')!=current['pci']
                                               or selection.get('confirmed',{}).get('arfcn')!=current['arfcn']):
                    candidates.append(current)
                state,target=decide(current,candidates,state,cfg,time.time())
                state['measured_neighbors']=len(cells)
                state['no_nr_samples']=0
                if target:
                    record_attempt(state,time.time())
                    state['phase'],state['expected_lock']=select_cell(current,target,cfg,baseline)
                    if state['phase']=='selected':
                        state['current']=load(HISTORY/'last-selection.json').get('confirmed')
                        state['lock_owner']='selection'
                    elif state['phase'] in ('external_lock_preserved','original_setting_restored'):
                        state['current']=None
                        if state['phase']=='external_lock_preserved':state['lock_owner']='external'
            report(old_state,state)
            if args.enable_auto:print(json.dumps(state,ensure_ascii=False))

if __name__=='__main__':
    try:main()
    except Exception as error:
        message=type(error).__name__
        if '--check' in sys.argv:
            print(json.dumps({'phase':'check_failed','error':message}),file=sys.stderr)
            raise SystemExit(1)
        previous=load(STATE)
        report(previous,previous|{'phase':'check_failed','error':message,'candidate':None,'count':0})
